{
  "manifest_version": 3,
  "name": "Cognitive Spotlight UI",
  "version": "5.0",
  "description": "V5 Core Camera Engine",
  "permissions": ["offscreen", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Calibration Dashboard" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["face-api.min.js", "models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}